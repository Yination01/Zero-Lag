{
  "name": "zero-lag",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Zero-Lag. Expo / React Native Android. Network lag tool for mobile gamers.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node .audit/agent-docs.cjs && node .audit/agent-rules.cjs && node .audit/legal.cjs && npm run typecheck && node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:app": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:agent-docs": "node .audit/agent-docs.cjs && node .audit/agent-rules.cjs",
    "start": "expo start",
    "android": "expo start --android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@zerolag/device": "file:plugins/zerolag-device",
    "@zerolag/hud": "file:plugins/zerolag-hud",
    "@zerolag/net": "file:plugins/zerolag-net",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3"
  }
}
