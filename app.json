{
  "expo": {
    "name": "Zero-Lag",
    "slug": "zero-lag",
    "version": "0.1.0",
    "icon": "./assets/zero-lag-icon.png",
    "splash": {
      "image": "./assets/zero-lag-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F14"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/zero-lag-adaptive-foreground.png",
        "backgroundColor": "#0A0F14"
      },
      "package": "com.yination01.zerolag",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_PHONE_STATE",
        "ACCESS_NETWORK_STATE",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "./plugins/zerolag-hud/withZeroLagHud.js"
    ],
    "extra": {
      "eas": {
        "projectId": "aca8aecf-ee68-413c-a362-80da8033c24c"
      }
    },
    "owner": "yination"
  }
}
